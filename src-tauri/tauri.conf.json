{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto WiFi Connector",
  "version": "0.6.0",
  "identifier": "com.autowificonnector.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Auto WiFi Connector",
        "width": 1080,
        "height": 740,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0RkE3ODE0NzVCM0RDOUIKUldTYjNMTjFGSGo2dEtvbW1BZ0QzRXBRL1dxOHoycVpVRm9CZG5tNlc0WUxsVXo5RE1nRkxlMnEK",
      "endpoints": [
        "https://github.com/MisakaMikoto128/auto_wifi_connector/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
