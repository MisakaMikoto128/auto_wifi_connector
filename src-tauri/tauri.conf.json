{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto WiFi Connector",
  "version": "0.2.6",
  "identifier": "com.autowificonnector.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Auto WiFi Connector",
        "width": 1080,
        "height": 740,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
